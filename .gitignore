.pihole-admin-pass
pihole-admin-pass

# TLS certificates and private keys
*.pem
*.crt
*.p12
*.pfx

# PCAP captures
*.pcap
*.pcapng

# Secrets / tokens
.env
.env.local
*.token

# Editor temp files
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
